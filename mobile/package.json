{
  "name": "@hepantalya/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android --device",
    "build": "expo export --platform android --output-dir dist",
    "export": "expo export --platform android --output-dir dist",
    "doctor": "expo-doctor",
    "lint": "eslint App.tsx src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.8.2",
    "@tanstack/react-query": "5.90.11",
    "axios": "1.18.0",
    "expo": "57.0.8",
    "expo-build-properties": "~57.0.7",
    "expo-camera": "57.0.3",
    "expo-crypto": "57.0.1",
    "expo-dev-client": "57.0.9",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-nfc-manager": "3.17.2",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@react-native/jest-preset": "0.86.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "expo-doctor": "1.20.1",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nfc-manager"
        ]
      }
    }
  }
}
