{
  "name": "@hepantalya/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:unit": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects unit",
    "test:integration": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects integration --runInBand",
    "test:concurrency": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects concurrency --runInBand",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/websockets": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "joi": "18.2.1",
    "nestjs-pino": "4.5.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.16.3",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.5",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "prisma": "7.9.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
